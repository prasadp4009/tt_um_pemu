# Makefile -- cocotb replay for Tarang PE+observer co-simulation.
# Usage:
#   make IMAGE=spi TRACE=/path/spi.bin HEX=/path/spi.hex \
#        PLOG=/path/spi.plog WAVES=1
# Env passthrough: COSIM_TRACE COSIM_HEX COSIM_PLOG
TOPLEVEL_LANG = verilog
SIM          ?= icarus
TOPLEVEL      = cosim_top
MODULE        = test_cosim

COSIM_DIR := $(shell pwd)
REPO      := $(COSIM_DIR)/../..

VERILOG_SOURCES += $(COSIM_DIR)/cosim_top.v
VERILOG_SOURCES += $(REPO)/src/tt_um_pemu_pe.v
VERILOG_SOURCES += $(REPO)/src/tt_um_pemu_observer.v
VERILOG_SOURCES += $(REPO)/test/sram_sim.v

# 50 MHz DUT clock is generated by the cocotb test.
COMPILE_ARGS += -g2012

export COSIM_TRACE ?= $(TRACE)
export COSIM_HEX   ?= $(HEX)
export COSIM_PLOG  ?= $(PLOG)

include $(shell cocotb-config --makefiles)/Makefile.sim
