# build.tcl -- synthesize + implement emu_top for xc7z010clg400-1 (Zybo).
# Run from the repo root:  vivado -mode batch -source fpga/build.tcl -tclargs <FREQ>
#   FREQ: 50, 100, 125, or 150 (MHz). One bitstream per frequency.
# Bitstream lands at fpga/emu_top_<FREQ>.bit.
#
# NOTE: $readmemh paths in fpga/emu_loader.v ("*.hex") resolve against
# the Vivado launch directory, so launch from the repo root.

set FREQ [lindex $argv 0]
if {$FREQ ni {50 100 125 150}} {
    puts "ERROR: FREQ must be 50, 100, 125, or 150 (got '$FREQ')"
    exit 1
}
puts "=== Building for ${FREQ} MHz ==="

# Generate fpga/clk_config.vh with the MMCM dividers for this frequency.
# Input 125 MHz. VCO and CLKOUT0_DIVIDE_F chosen for exact output.
# MULT_F must be a multiple of 0.125 (hardware granularity).
#   50 MHz:  VCO=1000 (MULT 8.0), DIV 20
#   100 MHz: VCO=1000 (MULT 8.0), DIV 10
#   125 MHz: VCO=1000 (MULT 8.0), DIV 8
#   150 MHz: VCO=750  (MULT 6.0), DIV 5
array set cfg {
    50  {8.0 20.0}
    100 {8.0 10.0}
    125 {8.0 8.0}
    150 {6.0 5.0}
}
lassign $cfg($FREQ) mult_f div_f
set vh [open fpga/clk_config.vh w]
puts $vh "// clk_config.vh -- auto-generated by build.tcl for ${FREQ} MHz. DO NOT EDIT."
puts $vh "`define CLKFBOUT_MULT_F $mult_f"
puts $vh "`define CLKOUT0_DIVIDE_F $div_f"
close $vh
puts "INFO: wrote fpga/clk_config.vh (MULT $mult_f, DIV $div_f)"

set part xc7z010clg400-1
set proj_dir ./fpga/proj_${FREQ}

create_project emu_fpga $proj_dir -part $part -force

add_files -norecurse [list \
  fpga/emu_top.v \
  fpga/emu_loader.v \
  fpga/sram_emu.v \
  src/tt_um_pemu.v \
  src/tt_um_pemu_pe.v \
  src/tt_um_pemu_host.v \
  src/tt_um_pemu_observer.v \
]
# The frozen ASIC RTL uses a SystemVerilog cast (5'(...)); parse as SV.
# This does not modify the files.
foreach f {src/tt_um_pemu.v src/tt_um_pemu_pe.v src/tt_um_pemu_host.v src/tt_um_pemu_observer.v} {
    set_property file_type SystemVerilog [get_files $f]
}
set_property top emu_top [current_fileset]
add_files -fileset constrs_1 -norecurse [list fpga/zybo.xdc]

# --- VIO: 3x32 probe_in (status, signature, heartbeats),
# ---      3x1 probe_out (start_test, reset, inject_fault)
# ---      (all probe_out 1 bit so OUTPUT_VALUE is unambiguous 0/1)
create_ip -name vio -vendor xilinx.com -library ip -module_name vio_0
set_property -dict [list \
  CONFIG.C_NUM_PROBE_IN {3} \
  CONFIG.C_PROBE_IN0_WIDTH {32} \
  CONFIG.C_PROBE_IN1_WIDTH {32} \
  CONFIG.C_PROBE_IN2_WIDTH {32} \
  CONFIG.C_NUM_PROBE_OUT {3} \
  CONFIG.C_PROBE_OUT0_WIDTH {1} \
  CONFIG.C_PROBE_OUT1_WIDTH {1} \
  CONFIG.C_PROBE_OUT2_WIDTH {1} \
] [get_ips vio_0]

# --- ILA: probe0[23:0]={milestones,st}, probe1[7:0]=uio_out,
# ---      probe2[7:0]={0,hp_tx,hp_rx,test_clk,dut_rst_n,rx_valid,tx_busy,done}
create_ip -name ila -vendor xilinx.com -library ip -module_name ila_0
set_property -dict [list \
  CONFIG.C_NUM_OF_PROBES {3} \
  CONFIG.C_PROBE0_WIDTH {24} \
  CONFIG.C_PROBE1_WIDTH {8} \
  CONFIG.C_PROBE2_WIDTH {8} \
  CONFIG.C_DATA_DEPTH {8192} \
  CONFIG.C_TRIGOUT_EN {false} \
  CONFIG.C_EN_STRG_QUAL {false} \
  CONFIG.C_ADV_TRIGGER {false} \
] [get_ips ila_0]

generate_target all [get_ips vio_0 ila_0]

launch_runs synth_1 -jobs 4
wait_on_run synth_1
if {[get_property PROGRESS [get_runs synth_1]] != "100%"} {
  puts "BUILD FAIL: synthesis did not complete"; exit 1
}
# confirm the program ROMs were picked up
# (hex files are loaded by $readmemh at synthesis; not added as sources)
# Add hex files to the project so synthesis $readmemh can find them.
add_files -norecurse [list fpga/halt_test.hex fpga/top_smoke.hex]

launch_runs impl_1 -jobs 4
wait_on_run impl_1

open_run impl_1
write_bitstream -force fpga/emu_top_${FREQ}.bit
write_debug_probes -force fpga/emu_top_${FREQ}.ltx
puts "BUILD DONE: fpga/emu_top_${FREQ}.bit + .ltx"
